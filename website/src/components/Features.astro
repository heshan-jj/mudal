---
import Icon from "./Icon.astro";
import { features } from "../data/site";

const tones = ["mint", "peach", "sun", "sage"];
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Features</p>
      <h2 id="features-title">What Mudal keeps track of</h2>
    </div>

    <ul class="grid">
      {
        features.map((f, i) => (
          <li class:list={["feature", `tone-${tones[i % tones.length]}`]} data-reveal style={`--i:${i % 3}`}>
            <span class="icon-badge">
              <Icon name={f.icon} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    background: var(--surface-low);
    border-radius: clamp(32px, 5vw, 64px);
    margin-inline: clamp(0px, 1.5vw, 1.25rem);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
  }

  .feature {
    --tone-bg: var(--primary-container);
    --tone-fg: var(--on-primary-container);
    grid-column: span 2;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 1.75rem;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--outline-variant);
    transition:
      background-color var(--dur-m) var(--emphasized),
      color var(--dur-m) var(--emphasized),
      border-radius var(--dur-l) var(--spring),
      transform var(--dur-l) var(--spring),
      box-shadow var(--dur-m) var(--emphasized);
  }

  .feature:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .feature:nth-child(5) {
    grid-column: 4 / span 2;
  }

  .tone-peach {
    --tone-bg: var(--tertiary-container);
    --tone-fg: var(--on-tertiary-container);
  }

  .tone-sun {
    --tone-bg: var(--sun-container);
    --tone-fg: var(--on-sun-container);
  }

  .tone-sage {
    --tone-bg: var(--secondary-container);
    --tone-fg: var(--on-secondary-container);
  }

  .feature:hover {
    background: var(--tone-bg);
    color: var(--tone-fg);
    border-radius: 48px 16px 48px 16px;
    transform: translateY(-6px);
    box-shadow: var(--shadow-2);
  }

  .feature .icon-badge {
    background: var(--tone-bg);
    color: var(--tone-fg);
  }

  .feature:hover .icon-badge {
    background: var(--surface);
    color: var(--tone-fg);
    border-radius: 50%;
    transform: rotate(-12deg) scale(1.1);
  }

  .feature h3 {
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .feature p {
    margin: 0;
    font-size: 0.97rem;
    opacity: 0.82;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .feature,
    .feature:nth-child(4),
    .feature:nth-child(5) {
      grid-column: auto;
    }

    .feature:last-child {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - 0.5rem);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .feature:last-child {
      width: auto;
    }
  }
</style>
