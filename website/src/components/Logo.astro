---
interface Props {
  size?: number;
  id?: string;
  class?: string;
}

const { size = 40, id = "logo", class: className } = Astro.props;
const back = `${id}-back`;
const front = `${id}-front`;
---

<svg
  class:list={["mudal-mark", className]}
  width={size}
  height={Math.round((size * 104) / 120)}
  viewBox="0 0 120 104"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={back} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="82" y2="79">
      <stop offset="0" stop-color="#93C4B5"></stop>
      <stop offset="1" stop-color="#3F8270"></stop>
    </linearGradient>
    <linearGradient id={front} gradientUnits="userSpaceOnUse" x1="48" y1="12" x2="91.2" y2="90">
      <stop offset="0" stop-color="#4A8E7B"></stop>
      <stop offset="1" stop-color="#1E5147"></stop>
    </linearGradient>
  </defs>
  <g class="bubble-back">
    <path
      d="M14 0 H68 A14 14 0 0 1 82 14 V65 A14 14 0 0 1 68 79 H14 A14 14 0 0 1 0 65 V14 A14 14 0 0 1 14 0 Z M16 72 L44 79 L8 102 Z"
      fill={`url(#${back})`}
    ></path>
  </g>
  <g class="bubble-front">
    <path
      d="M62 12 H106 A14 14 0 0 1 120 26 V76 A14 14 0 0 1 106 90 H62 A14 14 0 0 1 48 76 V26 A14 14 0 0 1 62 12 Z M86 86 L110 80 L116 102 Z"
      fill={`url(#${front})`}
      opacity="0.93"
    ></path>
  </g>
  <g class="purse" fill="none" stroke="#F4F8F5" stroke-width="5.5" stroke-linecap="round">
    <rect x="29" y="35" width="64" height="35" rx="10"></rect>
    <path class="bar bar-1" d="M52 45 V60"></path>
    <path class="bar bar-2" d="M70 45 V60"></path>
  </g>
</svg>

<style>
  .mudal-mark {
    overflow: visible;
  }

  .mudal-mark g {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 600ms var(--spring);
  }

  .bar {
    transform-box: fill-box;
    transform-origin: center bottom;
    transition: transform 500ms var(--spring);
  }

  :global(a:hover) > .mudal-mark .bubble-back,
  .mudal-mark:hover .bubble-back {
    transform: translate(-3px, -3px) rotate(-4deg);
  }

  :global(a:hover) > .mudal-mark .bubble-front,
  .mudal-mark:hover .bubble-front {
    transform: translate(3px, 2px) rotate(4deg);
  }

  :global(a:hover) > .mudal-mark .bar-1,
  .mudal-mark:hover .bar-1 {
    transform: scaleY(0.6);
  }

  :global(a:hover) > .mudal-mark .bar-2,
  .mudal-mark:hover .bar-2 {
    transform: scaleY(0.6);
    transition-delay: 80ms;
  }
</style>
