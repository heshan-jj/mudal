---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Shape from "./Shape.astro";
import { RELEASES_URL } from "../data/site";
---

<section class="section" id="download" aria-labelledby="download-title">
  <div class="container">
    <div class="cta" data-reveal>
      <Shape kind="burst" size={340} class="cta-shape" />
      <div class="cta-copy">
        <p class="eyebrow">Download</p>
        <h2 id="download-title">Get Mudal</h2>
        <p class="lead">A signed APK for Android 8.0 and newer.</p>
        <div class="actions">
          <a class="btn btn-primary big" href={RELEASES_URL}>
            <Icon name="download" />
            Download the latest APK
          </a>
        </div>
      </div>
      <div class="cta-logo" aria-hidden="true">
        <Logo size={190} id="logo-cta" />
      </div>
    </div>

    <div class="card step-card install" data-reveal>
      <h3>How to install</h3>
      <ol>
        <li>Download the APK on your phone and open it. If asked, allow your browser to install unknown apps.</li>
        <li>
          On Android 14 or newer, open <strong>Settings → Apps → Mudal</strong>, tap the <strong>⋮</strong> menu and
          choose <strong>Allow restricted settings</strong>, then grant SMS permission.
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: clamp(32px, 5vw, 56px);
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  .cta :global(.cta-shape) {
    position: absolute;
    right: -60px;
    top: 50%;
    translate: 0 -50%;
    z-index: -1;
    color: var(--sun-container);
    animation: spin 30s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .cta .eyebrow {
    background: var(--surface);
    color: var(--on-primary-container);
  }

  .cta h2 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
  }

  .cta .lead {
    color: var(--on-primary-container);
    opacity: 0.85;
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 2rem 0 1.5rem;
  }

  .big {
    min-height: 64px;
    padding-inline: 2rem;
    font-size: 1.12rem;
  }

  .cta-logo {
    display: grid;
    place-items: center;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-3);
    animation: bob 5s ease-in-out infinite;
    transition: border-radius var(--dur-l) var(--spring);
  }

  .cta-logo:hover {
    border-radius: 72px;
  }

  @keyframes bob {
    50% {
      transform: translateY(-12px) rotate(3deg);
    }
  }

  .install {
    margin-top: 1rem;
  }

  .step-card {
    transition: border-radius var(--dur-l) var(--spring), transform var(--dur-l) var(--spring);
  }

  .step-card:hover {
    border-radius: var(--r-xl);
    transform: translateY(-4px);
  }

  .step-card ol {
    counter-reset: step;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .step-card li {
    counter-increment: step;
    position: relative;
    padding-left: 2.75rem;
    min-height: 2rem;
  }

  .step-card li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-weight: 700;
    font-size: 0.9rem;
    transition: transform var(--dur-m) var(--spring), border-radius var(--dur-m) var(--spring);
  }

  .step-card li:hover::before {
    transform: scale(1.15) rotate(-10deg);
    border-radius: 10px;
  }

  @media (max-width: 860px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta-logo {
      display: none;
    }
  }
</style>
