---
import { faqs, ISSUES_URL } from "../data/site";
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="side" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions, answered</h2>
      <p class="lead">The things people ask most before trusting an app with their bank SMS.</p>
      <a class="btn btn-tonal" href={ISSUES_URL}>Ask something else</a>
    </div>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details open={i === 0} data-reveal style={`--i:${i % 4}`}>
            <summary>
              <span>{f.q}</span>
              <span class="toggle" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .side {
    position: sticky;
    top: 7rem;
  }

  .faq-list {
    display: grid;
    gap: 0.6rem;
    interpolate-size: allow-keywords;
  }

  details {
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--outline-variant);
    transition:
      border-radius var(--dur-l) var(--spring),
      background-color var(--dur-m) var(--emphasized),
      transform var(--dur-m) var(--spring);
  }

  details:hover {
    transform: translateX(4px);
  }

  details[open] {
    border-radius: var(--r-xl);
    background: var(--secondary-container);
    box-shadow: none;
  }

  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-m) var(--emphasized),
      content-visibility var(--dur-m) allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    font-weight: 600;
    font-size: 1.08rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--surface-container);
    transition:
      transform var(--dur-l) var(--spring),
      border-radius var(--dur-l) var(--spring),
      background-color var(--dur-m);
  }

  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--on-secondary-container);
    translate: -50% -50%;
  }

  .toggle::after {
    rotate: 90deg;
  }

  details[open] .toggle {
    transform: rotate(135deg);
    border-radius: 50%;
    background: var(--primary);
  }

  details[open] .toggle::before,
  details[open] .toggle::after {
    background: var(--on-primary);
  }

  .answer p {
    margin: 0;
    padding: 0 1.4rem 1.35rem;
    color: var(--on-secondary-container);
    opacity: 0.88;
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }
</style>
