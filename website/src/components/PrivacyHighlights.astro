---
import Icon from "./Icon.astro";
import Shape from "./Shape.astro";
import type { IconName } from "../data/site";

const points: { icon: IconName; title: string; body: string }[] = [
  {
    icon: "shield",
    title: "Stays on your phone",
    body: "SMS parsing, categories, budgets and storage all happen on the device. There is no Mudal server.",
  },
  {
    icon: "lock",
    title: "Encrypted database",
    body: "Your transactions are stored with SQLCipher, using a key locked inside Android’s hardware keystore.",
  },
  {
    icon: "user",
    title: "No account",
    body: "No sign-up, no email, no phone number. Install it and start.",
  },
  {
    icon: "eyeOff",
    title: "No trackers",
    body: "No analytics, no ads, no crash reporters, no billing. Not even on this website.",
  },
  {
    icon: "code",
    title: "Open source",
    body: "The full source is public under the AGPL-3.0, so anyone can check exactly what Mudal does.",
  },
  {
    icon: "gift",
    title: "Free, for real",
    body: "No subscription, no in-app purchases, no Pro tier. Nothing to sell, so no reason to collect your data.",
  },
];
---

<section class="section private" id="private" aria-labelledby="private-title">
  <Shape kind="cookie" size={520} class="bg-shape one" />
  <Shape kind="flower" size={300} class="bg-shape two" />
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">Private by design</p>
      <h2 id="private-title">Your finances are nobody else’s business</h2>
      <p class="lead">
        Bank SMS are some of the most personal data on your phone. Mudal is built so they never have to leave it.
      </p>
    </div>

    <ul class="grid">
      {
        points.map((p, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <span class="icon-badge">
              <Icon name={p.icon} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="center-link" data-reveal>
      <a class="btn btn-light" href="#privacy">Read the full privacy policy</a>
    </p>
  </div>
</section>

<style>
  .private {
    overflow: hidden;
    background: var(--primary-strong);
    color: #e6f2ed;
    border-radius: clamp(32px, 5vw, 64px);
    margin-inline: clamp(0px, 1.5vw, 1.25rem);
  }

  .private :global(.bg-shape) {
    position: absolute;
    color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }

  .private :global(.one) {
    top: -160px;
    right: -140px;
    animation: spin 80s linear infinite;
  }

  .private :global(.two) {
    bottom: -80px;
    left: -60px;
    animation: spin 50s linear infinite reverse;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .container {
    position: relative;
  }

  .eyebrow {
    background: rgba(255, 255, 255, 0.12);
    color: #e6f2ed;
  }

  .eyebrow::before {
    background: var(--primary-container);
  }

  h2 {
    color: #fff;
  }

  .lead {
    color: rgba(230, 242, 237, 0.8);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  li {
    padding: 1.75rem;
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition:
      background-color var(--dur-m) var(--emphasized),
      border-radius var(--dur-l) var(--spring),
      transform var(--dur-l) var(--spring);
  }

  li:hover {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 16px 48px 16px 48px;
    transform: translateY(-5px);
  }

  li .icon-badge {
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  li:hover .icon-badge {
    border-radius: 50%;
    transform: rotate(12deg) scale(1.1);
    background: var(--sun-container);
    color: var(--on-sun-container);
  }

  h3 {
    color: #fff;
    margin: 1.25rem 0 0.35rem;
  }

  li p {
    margin: 0;
    font-size: 0.98rem;
    color: rgba(230, 242, 237, 0.78);
  }

  .center-link {
    text-align: center;
    margin: 3rem 0 0;
  }

  .btn-light,
  .btn-light:hover {
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  @media (max-width: 920px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
