---
import Icon from "./Icon.astro";
import Shape from "./Shape.astro";
import PhoneMockup from "./PhoneMockup.astro";
import { RELEASES_URL, REPO_URL } from "../data/site";

const pills = ["100% on-device", "Encrypted database", "No ads, no paywall", "Android 8.0+"];
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="copy">
      <p class="tagline" data-reveal>
        <span class="dot"></span>
        Free · Private · Made for Sri Lanka
      </p>
      <h1 data-reveal style="--i:1">
        Your bank texts you.
        <span class="line2">
          Mudal makes it a
          <span class="pop">budget</span>
        </span>
      </h1>
      <p class="lead" data-reveal style="--i:2">
        A free, private expense tracker for Sri Lanka. Mudal reads your bank SMS on your phone and builds your
        spending, budgets and savings goals for you — no typing, no sign-up, nothing uploaded.
      </p>

      <div class="actions" data-reveal style="--i:3">
        <a class="btn btn-primary" href={RELEASES_URL}>
          <Icon name="download" />
          Download for Android
        </a>
        <a class="btn btn-tonal" href={REPO_URL}>
          <Icon name="github" />
          View the source
        </a>
      </div>

      <ul class="pills" aria-label="At a glance">
        {
          pills.map((p, i) => (
            <li data-reveal style={`--i:${i + 4}`}>
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="visual" data-reveal style="--i:2">
      <Shape kind="cookie" size={460} class="shape s-cookie" />
      <Shape kind="flower" size={150} class="shape s-flower" />
      <Shape kind="burst" size={110} class="shape s-burst" />
      <div class="float">
        <PhoneMockup />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1.1rem 0.5rem 0.8rem;
    border-radius: var(--r-full);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--outline-variant), var(--shadow-1);
    color: var(--primary-strong);
    font-weight: 500;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary) 50%, transparent);
    animation: ping 2.2s var(--emphasized) infinite;
  }

  @keyframes ping {
    70%,
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  h1 {
    font-size: clamp(2.6rem, 5.8vw, 4.4rem);
    margin-bottom: 0.45em;
  }

  .line2 {
    display: block;
    color: var(--primary);
  }

  .pop {
    display: inline-block;
    padding: 0 0.28em 0.06em;
    border-radius: 0.38em;
    background: var(--primary-container);
    color: var(--on-primary-container);
    transform: rotate(-2deg);
    transition:
      transform var(--dur-l) var(--spring),
      border-radius var(--dur-l) var(--spring),
      background-color var(--dur-m) ease;
    animation: wobble 5s var(--spring) 1.5s infinite;
  }

  .pop:hover {
    transform: rotate(2deg) scale(1.06);
    border-radius: 0.7em;
    background: var(--sun-container);
    color: var(--on-sun-container);
  }

  @keyframes wobble {
    0%,
    86%,
    100% {
      transform: rotate(-2deg);
    }
    90% {
      transform: rotate(3deg) scale(1.05);
    }
    94% {
      transform: rotate(-3deg);
    }
  }

  .lead {
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 2.25rem 0 2rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pills li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--on-secondary-container);
    padding: 0.45rem 0.95rem 0.45rem 0.6rem;
    border-radius: var(--r-sm);
    background: var(--secondary-container);
    transition:
      border-radius var(--dur-m) var(--spring),
      transform var(--dur-m) var(--spring),
      background-color var(--dur-s) ease;
  }

  .pills li::before {
    content: "✓";
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .pills li:hover {
    border-radius: var(--r-full);
    transform: translateY(-2px);
    background: var(--primary-container);
  }

  .visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 560px;
  }

  .visual :global(.shape) {
    position: absolute;
    pointer-events: none;
  }

  .visual :global(.s-cookie) {
    width: min(115%, 470px);
    height: auto;
    color: var(--primary-container);
    animation: spin 60s linear infinite;
  }

  .visual :global(.s-flower) {
    top: 4%;
    left: -2%;
    color: var(--tertiary-container);
    animation: spin 24s linear infinite reverse, bob 6s ease-in-out infinite;
  }

  .visual :global(.s-burst) {
    bottom: 6%;
    right: 0;
    color: var(--sun-container);
    animation: spin 18s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes bob {
    50% {
      translate: 0 14px;
    }
  }

  .float {
    position: relative;
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-14px) rotate(1deg);
    }
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .visual {
      min-height: 0;
      padding-block: 2rem;
    }
  }
</style>
